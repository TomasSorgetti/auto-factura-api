APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=text

CORS_ALLOWED_ORIGINS=
DATABASE_URL=postgres://<user>:<password>@localhost:5432/autofactura?sslmode=disable
DB_MAX_CONNS=5
DB_STATEMENT_TIMEOUT=5s
TEST_DATABASE_URL=postgres://<user>:<password>@localhost:5432/postgres?sslmode=disable

REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/15

MASTER_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
ARGON2_MEMORY_KIB=19456
ARGON2_TIME=2
ARGON2_THREADS=1
RESEND_API_KEY=
EMAIL_FROM=Auto Factura <avisos@example.com>
PUBLIC_BASE_URL=http://localhost:5173
BUSINESS_TZ=America/Argentina/Buenos_Aires
